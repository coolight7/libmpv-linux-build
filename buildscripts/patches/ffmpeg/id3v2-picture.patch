-        goto fail;
-    }
+               "Unknown attached picture mimetype: %s, try to detect by magic number.\n",
+               mimetype);
+    /* The codec is guessed from the picture data below when it is unknown */
     apic->id = id;
 
     /* picture type */
@@ -682,6 +699,19 @@ static void read_apic(AVFormatContext *s, AVIOContext *pb, int taglen,
         goto fail;
     memset(apic->buf->data + taglen, 0, AV_INPUT_BUFFER_PADDING_SIZE);
 
+    if (apic->id == AV_CODEC_ID_NONE) {
+        /* The MIME type is unknown, guess the codec from the picture data */
+        apic->id = ff_id3v2_guess_picture_id(apic->buf->data, taglen);
+        if (apic->id == AV_CODEC_ID_NONE) {
+            apic->id = AV_CODEC_ID_MJPEG;
+            av_log(s, AV_LOG_WARNING, "Can't detect attached picture format, "
+                   "default to JPEG (AV_CODEC_ID_MJPEG).\n");
+        } else {
+            av_log(s, AV_LOG_INFO, "Detected attached picture as %s by magic number.\n",
+                   avcodec_get_name(apic->id));
