diff --git a/libavformat/id3v2.c b/libavformat/id3v2.c
index 21c09d1..1f5740b 100644
--- a/libavformat/id3v2.c
+++ b/libavformat/id3v2.c
@@ -147,6 +147,23 @@ const CodecMime ff_id3v2_mime_tags[] = {
     { "",           AV_CODEC_ID_NONE   },
 };
 
+enum AVCodecID ff_id3v2_guess_picture_id(const uint8_t *data, unsigned int size)
+{
+    if (!data)
+        return AV_CODEC_ID_NONE;
+
+    /* JPEG: SOI marker followed by the first marker (FF D8 FF) */
+    if (size >= 3 && data[0] == 0xff && data[1] == 0xd8 && data[2] == 0xff)
+        return AV_CODEC_ID_MJPEG;
+
+    /* PNG: first 4 bytes of the 8 bytes signature (89 50 4e 47) */
+    if (size >= 4 && data[0] == 0x89 && data[1] == 'P' &&
+        data[2] == 'N' && data[3] == 'G')
+        return AV_CODEC_ID_PNG;
+
+    return AV_CODEC_ID_NONE;
+}
+
 int ff_id3v2_match(const uint8_t *buf, const char *magic)
 {
     return  buf[0]         == magic[0] &&
@@ -653,11 +670,11 @@ static void read_apic(AVFormatContext *s, AVIOContext *pb, int taglen,
