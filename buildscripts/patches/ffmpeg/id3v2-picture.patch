diff --git a/libavformat/id3v2.h b/libavformat/id3v2.h
index 9afa5a2..ab2e60a 100644
--- a/libavformat/id3v2.h
+++ b/libavformat/id3v2.h
@@ -211,4 +211,15 @@ extern const CodecMime ff_id3v2_mime_tags[];
 
 extern const char * const ff_id3v2_picture_types[21];
 
+/**
+ * Guess the codec of an attached picture from the magic number of its data.
+ * Used as a fallback when the picture MIME type is missing or unknown.
+ *
+ * @param data picture data, at least `size` bytes are read
+ * @param size size of the picture data in bytes
+ * @return the guessed codec id, or AV_CODEC_ID_NONE if the format is not
+ *         recognized
+ */
+enum AVCodecID ff_id3v2_guess_picture_id(const uint8_t *data, unsigned int size);
+
 #endif /* AVFORMAT_ID3V2_H */
